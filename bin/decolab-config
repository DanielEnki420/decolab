#!/usr/bin/env bash
# decolab-config - write or check a Decolab configuration file
#
#   decolab-config init [--defaults] [FILE]   ask a few questions, write FILE
#   decolab-config check [FILE]               validate FILE
#
# FILE defaults to ./decolab.conf. init never overwrites a file; --defaults
# takes every suggestion without asking. Exit codes: 0 done or valid,
# 1 invalid or nothing written, 2 usage error.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/config.sh
. "$here/../lib/config.sh"

usage() {
  sed -n '2,9s/^# \{0,1\}//p' "${BASH_SOURCE[0]}" >&2
  exit 2
}

[ $# -ge 1 ] || usage
cmd=$1
shift
case $cmd in
  check)
    [ $# -le 1 ] || usage
    file=${1:-decolab.conf}
    if decolab_config_load "$file"; then
      printf 'OK: %s is valid (%s settings)\n' "$file" "$DECOLAB_CONFIG_COUNT"
    else
      printf 'INVALID: %s has %s error(s)\n' "$file" "$DECOLAB_CONFIG_ERRORS" >&2
      exit 1
    fi
    ;;
  init)
    # shellcheck source=lib/config-init.sh
    . "$here/../lib/config-init.sh"
    defaults=()
    if [ "${1:-}" = --defaults ]; then defaults=(--defaults); shift; fi
    [ $# -le 1 ] || usage
    decolab_config_init ${defaults[@]+"${defaults[@]}"} "${1:-decolab.conf}"
    ;;
  -h | --help | help) usage ;;
  *) usage ;;
esac
