#!/usr/bin/env bash
# decolab-firewall - the host firewall (HARDENING=yes), with a way back.
#
#   decolab-firewall rules              print the rule set for this config
#   decolab-firewall check              would apply work from this login?
#   sudo decolab-firewall apply         load it for 5 minutes, on trial
#   sudo decolab-firewall confirm       from a NEW SSH login: keep it
#   sudo decolab-firewall off           switch it off (also SSH as before)
#   decolab-firewall status
#
# One nftables table of its own, "inet decolab", for IPv4 and IPv6 alike,
# loaded in one transaction: a rule set never stands half loaded. Docker's,
# Tailscale's and CrowdSec's tables stay untouched; the way back is deleting
# this one table. No UFW: it is refused while active (two firewalls, and an
# "allow" in one would silently mean nothing).
#
# What it lets in, from LAN_SUBNET (and IPv6 link-local / ULA) only:
#   SSH_PORT, DNS 53 (Pi-hole), Samba 139/445, mDNS, and the web interfaces
#   if WEB_UI_ADDRESS=HOST_LAN_IP. From everywhere: replies, ping, DHCP,
#   Tailscale (all of tailscale0 and its UDP port). Containers reach the host
#   for DNS only. Everything else is dropped and a sample logged ("decolab-drop").
#
# Nothing is permanent until confirmed: apply arms a timer first (systemd-run,
# 5 minutes) that runs decolab-firewall-boot off. Only "confirm" from a login
# that started AFTER the apply, over the LAN, stops it and enables
# decolab-firewall.service. A reboot before that leaves the firewall off.
# Break-glass: a file decolab-firewall-off on the boot partition.
#
# Also part of apply, and of the way back: the SSH drop-in
# config/firewall/sshd-decolab.conf (no port change). With SSH_PASSWORDS=no it
# also turns passwords off: the new login that confirms then proves a key works.
#
# Test hooks: FW_ROOT (prefix for every host path; root is then not needed),
# FW_BOOT (the boot script to run for "off"), FW_ROLLBACK_S (default 300).
set -uo pipefail
# shellcheck source-path=SCRIPTDIR/..
# shellcheck source=lib/common.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/common.sh"
decolab_init
PATH=$PATH:/usr/local/sbin:/usr/sbin:/sbin

r=${FW_ROOT:-}
state=$r/var/lib/decolab
pending=$state/firewall-pending
pending_rules=$state/firewall-pending.nft
confirmed=$state/firewall-confirmed
rules_file=$r/etc/decolab/firewall.nft
dropin=$r/etc/ssh/sshd_config.d/01-decolab.conf
boot=${FW_BOOT:-$r/usr/local/sbin/decolab-firewall-boot}
wait_s=${FW_ROLLBACK_S:-300}
timer=decolab-firewall-rollback

# --- the rule set --------------------------------------------------------------
# The host ports of the web interfaces (compose files, "${WEB_UI_ADDRESS}:PORT").
# tests/test-firewall.sh compares this list with the compose files.
ui_ports() {
  printf '%s\n' 8053 9000
  is_yes MODULE_UPTIME_KUMA && echo 3001
  is_yes MODULE_IMMICH && echo 2283
  return 0
}

rules() {
  local lan6="fe80::/10, fc00::/7" ui=""
  if [ "$WEB_UI_ADDRESS" = "$HOST_LAN_IP" ]; then
    # the compose ports, then Decolab's own panel (panel/server.py)
    ui=$({ ui_ports && echo "$PANEL_PORT"; } | tr '\n' ',' | sed 's/,$//; s/,/, /g')
  fi
  cat <<EOF
# Generated by decolab-firewall from decolab.conf. Do not edit: change the
# configuration and run "decolab-firewall apply" again.
#
# The first two lines make loading it again a replacement, never a duplicate,
# and touch nothing but this table (never "flush ruleset": that would delete
# Docker's, Tailscale's and CrowdSec's rules).
table inet decolab {}
delete table inet decolab

table inet decolab {
  set lan4 { type ipv4_addr; flags interval; elements = { $LAN_SUBNET } }
  set lan6 { type ipv6_addr; flags interval; elements = { $lan6 } }

  # Traffic to the host itself: SSH, and the ports Docker's proxy serves on
  # [::] (IPv6 reaches containers through the host, not through forward).
  chain input {
    type filter hook input priority filter - 1; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "lo" accept
    iifname "tailscale0" accept
    # Containers to the host: DNS only (a container may ask HOST_LAN_IP:53;
    # Docker's proxy takes that on input). Nothing in Decolab needs more, and
    # a compromised container must not reach SSH, Samba or the panel.
    iifname { "docker0", "br-*" } meta l4proto { tcp, udp } th dport 53 accept
    meta l4proto icmp accept
    meta l4proto ipv6-icmp accept
    udp dport 68 accept
    ip6 saddr fe80::/10 udp dport 546 accept
EOF
  is_yes TAILSCALE && echo "    udp dport 41641 accept"
  cat <<EOF
    ip saddr @lan4 tcp dport $SSH_PORT accept
    ip6 saddr @lan6 tcp dport $SSH_PORT accept
    ip saddr @lan4 udp dport 5353 accept
    ip6 saddr @lan6 udp dport 5353 accept
    ip saddr @lan4 meta l4proto { tcp, udp } th dport 53 accept
    ip6 saddr @lan6 meta l4proto { tcp, udp } th dport 53 accept
    ip saddr @lan4 tcp dport { 139, 445 } accept
    ip6 saddr @lan6 tcp dport { 139, 445 } accept
EOF
  [ -z "$ui" ] || echo "    ip saddr @lan4 tcp dport { $ui } accept"
  cat <<EOF
    limit rate 4/minute log prefix "decolab-drop in: "
  }

  # Traffic through the host: published container ports (after Docker's
  # DNAT; "ct original proto-dst" is the port the client asked for). An
  # accept here only hands over to Docker's own chains; a drop is final.
  # Internal interfaces by name, never "everything but eth0": a second
  # network card or the WLAN would otherwise be wide open.
  chain forward {
    type filter hook forward priority filter - 1; policy accept;
    ct state established,related accept
    iifname { "docker0", "br-*", "veth*", "tailscale0" } accept
    ct status dnat ip saddr @lan4 meta l4proto { tcp, udp } ct original proto-dst 53 accept
    ct status dnat ip saddr @lan4 meta l4proto tcp ct original proto-dst { 139, 445 } accept
EOF
  [ -z "$ui" ] || echo "    ct status dnat ip saddr @lan4 meta l4proto tcp ct original proto-dst { $ui } accept"
  cat <<EOF
    limit rate 4/minute log prefix "decolab-drop fwd: "
    drop
  }
}
EOF
}

# --- who is asking ---------------------------------------------------------------
# session - the SSH login this command runs in, from the process tree, not
# from SSH_CONNECTION (tmux and screen keep a stale one). Sets
#   S_KIND   ssh | console | none
#   S_PEER   the client address (ssh)
#   S_START  epoch seconds the login started (ssh)
session() {
  local p=$$ i=0 c pids="" pid line peer age
  S_KIND=none S_PEER="" S_START=0
  while [ -n "$p" ] && [ "$p" -gt 1 ] && [ "$i" -lt 40 ]; do
    c=$(ps -o comm= -p "$p" 2>/dev/null | sed 's#.*/##')
    case $c in sshd*) pids="$pids $p" ;; esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    i=$((i + 1))
  done
  if [ -z "$pids" ]; then
    if [ -t 0 ]; then S_KIND=console; fi
    return 0
  fi
  for pid in $pids; do
    line=$(ss -tnpH state established "( sport = :$SSH_PORT )" 2>/dev/null | grep -E "pid=$pid," | head -1)
    [ -n "$line" ] || continue
    # shellcheck disable=SC2086 # columns, split on purpose
    set -- $line
    peer=${4%:*}
    peer=${peer#[} peer=${peer%]} peer=${peer#::ffff:}
    age=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
    case $age in '' | *[!0-9]*) continue ;; esac
    S_KIND=ssh S_PEER=$peer S_START=$(($(date +%s) - age))
    return 0
  done
  # Not root: ss shows no process of root's sshd, so its socket is not
  # ours to find. check (the only command that runs without root) may then
  # take the address sshd put into the environment; apply and confirm run as
  # root and keep measuring it.
  if [ "$(id -u)" != 0 ] && [ -n "${SSH_CONNECTION:-}" ]; then
    # shellcheck disable=SC2086 # the pids, split on purpose
    set -- $pids
    age=$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')
    case $age in '' | *[!0-9]*) age=0 ;; esac
    S_KIND=ssh S_PEER=${SSH_CONNECTION%% *} S_START=$(($(date +%s) - age))
    return 0
  fi
  # An sshd above us, but no socket of it (another port, or ss without -p)
  S_KIND=ssh-unknown
}

# where ADDRESS - lan | tailscale | other
where() {
  python3 -I -c 'import ipaddress, sys
a = ipaddress.ip_address(sys.argv[1])
lan = ipaddress.ip_network(sys.argv[2])
if a.version == 4 and a in lan:
    print("lan")
elif a.version == 6 and (a.is_link_local or a in ipaddress.ip_network("fc00::/7")) \
        and a not in ipaddress.ip_network("fd7a:115c:a1e0::/48"):
    print("lan")
elif a in ipaddress.ip_network("100.64.0.0/10") or a in ipaddress.ip_network("fd7a:115c:a1e0::/48"):
    print("tailscale")
else:
    print("other")' "$1" "$LAN_SUBNET" 2>/dev/null || echo other
}

# --- checks ----------------------------------------------------------------------
problems=""
problem() {
  problems="$problems  - $1"$'\n'
}

preflight() {
  problems=""
  is_yes HARDENING || problem "HARDENING=no in $DECOLAB_CONF"
  command -v nft >/dev/null 2>&1 || problem "nft is missing:  sudo apt install nftables"
  local u
  for u in ufw firewalld; do
    [ "$(systemctl is-active "$u" 2>/dev/null)" != active ] ||
      problem "$u is active: two firewalls would contradict each other. Switch it off first (sudo $([ $u = ufw ] && echo 'ufw disable' || echo 'systemctl disable --now firewalld'))"
  done
  # Debian's own service loads /etc/nftables.conf, which starts with "flush
  # ruleset": at its next start this firewall and Docker's rules would be gone.
  [ "$(systemctl is-enabled nftables.service 2>/dev/null)" != enabled ] ||
    problem "nftables.service is enabled: its /etc/nftables.conf flushes every rule, this firewall's included. Switch it off first (sudo systemctl disable --now nftables)"
  if ! is_yes SSH_PASSWORDS; then
    local home keys
    home=$(python3 -I -c 'import pwd, sys; print(pwd.getpwnam(sys.argv[1]).pw_dir)' "$DECOLAB_USER" 2>/dev/null)
    keys=$r$home/.ssh/authorized_keys
    grep -qE '^[^#[:space:]]' "$keys" 2>/dev/null ||
      problem "SSH_PASSWORDS=no, but $keys holds no key: you could not log in any more. Copy your key first (ssh-copy-id)"
  fi
  [ -n "$(ss -ltnH "( sport = :$SSH_PORT )" 2>/dev/null)" ] ||
    problem "nothing listens on SSH_PORT $SSH_PORT: the rules would let SSH in on a port sshd does not use"
  ip -o addr show 2>/dev/null | grep -qE "inet $HOST_LAN_IP/" ||
    problem "HOST_LAN_IP $HOST_LAN_IP is on no interface of this host"
  session
  case $S_KIND in
    console) ;;
    none) problem "neither an SSH login nor a terminal: run this by hand, in a login" ;;
    ssh-unknown) problem "cannot see from where this SSH login comes (is sshd on port $SSH_PORT?)" ;;
    ssh)
      case $(where "$S_PEER") in
        lan) ;;
        tailscale) is_yes TAILSCALE || problem "this login comes over Tailscale, but TAILSCALE=no: the rules would not let it in" ;;
        *) problem "this login comes from $S_PEER, outside LAN_SUBNET $LAN_SUBNET: the rules would cut it off" ;;
      esac ;;
  esac
  if is_root && command -v nft >/dev/null 2>&1; then
    rules >"$work/rules.nft"
    nft -c -f "$work/rules.nft" 2>"$work/nft.err" || problem "nft rejects the rule set: $(head -3 "$work/nft.err" | tr '\n' ' ')"
  fi
  [ -z "$problems" ]
}

# With FW_ROOT (tests) nothing real is touched, so root is not required.
is_root() { [ "$(id -u)" = 0 ] || [ -n "$r" ]; }
need_root() { is_root || die "run it with sudo: sudo $0 $1"; }
timer_active() { [ "$(systemctl is-active "$timer.timer" 2>/dev/null)" = active ]; }

work=$(mktemp -d "${TMPDIR:-/tmp}/decolab-firewall.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT

case ${1:-} in
  rules) rules ;;
  check)
    if preflight; then
      echo "OK: apply would keep this login ($S_KIND${S_PEER:+ from $S_PEER})."
    else
      printf 'apply would be refused:\n%s' "$problems"
      exit 1
    fi ;;
  apply)
    need_root apply
    preflight || { printf 'Nothing changed. First fix:\n%s' "$problems" && exit 1; }
    mkdir -p "$state" || exit 1
    rules >"$pending_rules"
    date +%s >"$pending"
    # The way back first: no rule is loaded before it is armed.
    systemctl reset-failed "$timer.timer" "$timer.service" >/dev/null 2>&1
    systemd-run --quiet --on-active="$wait_s" --timer-property=AccuracySec=1s --unit="$timer" "$boot" off >/dev/null 2>&1
    if ! timer_active; then
      rm -f "$pending" "$pending_rules"
      die "the way back (timer $timer) could not be armed: nothing changed"
    fi
    nft -f "$pending_rules" || { "$boot" off "nft -f failed" && die "loading the rules failed: switched off again"; }
    mkdir -p "$(dirname "$dropin")"
    cp "$decolab_root/config/firewall/sshd-decolab.conf" "$dropin" && chmod 644 "$dropin"
    is_yes SSH_PASSWORDS || printf '%s\n' "" "# SSH_PASSWORDS=no (decolab.conf): keys only" \
      "PasswordAuthentication no" "KbdInteractiveAuthentication no" >>"$dropin"
    if sshd -t 2>"$work/sshd.err"; then
      systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || warn "sshd reload failed"
    else
      rm -f "$dropin"
      is_yes SSH_PASSWORDS || { "$boot" off "sshd rejects the drop-in"; die "sshd rejects the drop-in ($(head -1 "$work/sshd.err")): SSH_PASSWORDS=no cannot take effect, switched off again"; }
      warn "sshd rejects the drop-in ($(head -1 "$work/sshd.err")): left out, SSH unchanged"
    fi
    # What sshd really does for this user: a Match block or another drop-in
    # could still allow passwords, and confirm would then prove nothing.
    if ! is_yes SSH_PASSWORDS; then
      pw=$(sshd -T -C "user=$DECOLAB_USER,host=localhost,addr=${S_PEER:-127.0.0.1}" 2>/dev/null | awk '$1 == "passwordauthentication" { print $2 }')
      if [ "$pw" != no ]; then
        "$boot" off "sshd still allows passwords"
        die "SSH_PASSWORDS=no, but sshd still allows passwords for $DECOLAB_USER (${pw:-unknown}; a Match block?): switched off again"
      fi
    fi
    log "ON TRIAL: the firewall is loaded for $((wait_s / 60)) minutes."
    cat <<EOF

Now prove that you can still get in$(is_yes SSH_PASSWORDS || echo ", with your key: passwords are off"). Within $((wait_s / 60)) minutes:
  1. open a NEW SSH login from a computer in your LAN (a new terminal window;
     not tmux or screen, and no shared connection: ssh -o ControlPath=none ...)
  2. there:  sudo $decolab_root/bin/decolab-firewall confirm
Without that, everything switches itself off again at $(date -d "@$(($(date +%s) + wait_s))" +%H:%M 2>/dev/null || date -r "$(($(date +%s) + wait_s))" +%H:%M).
Locked out anyway? Wait $((wait_s / 60)) minutes, or put a file named decolab-firewall-off
on the SD card's boot partition and restart.
EOF
    ;;
  confirm)
    need_root confirm
    [ -f "$pending" ] || die "nothing to confirm: run apply first"
    at=$(cat "$pending")
    session
    [ "$S_KIND" = ssh ] || die "confirm only from an SSH login (this is: $S_KIND): that is what proves the way in"
    [ "$S_START" -ge "$at" ] || die "this login started before the apply: it proves nothing. Open a NEW one (not tmux, ssh -o ControlPath=none)"
    w=$(where "$S_PEER")
    if [ "$w" = tailscale ] && [ "${2:-}" != --tailscale-ok ]; then
      die "this login comes over Tailscale; the LAN way in is not proven (it is the one that works when Tailscale is down). Log in over the LAN, or: confirm --tailscale-ok"
    fi
    [ "$w" = lan ] || [ "$w" = tailscale ] || die "this login comes from $S_PEER: neither LAN nor Tailscale"
    timer_active || die "the trial is over (the timer already switched it off): run apply again"
    mkdir -p "$(dirname "$rules_file")"
    if ! { cp "$pending_rules" "$rules_file.new" && chmod 644 "$rules_file.new" && mv "$rules_file.new" "$rules_file"; }; then
      die "cannot write $rules_file: the trial continues and ends by itself"
    fi
    systemctl enable decolab-firewall.service >/dev/null 2>&1 || die "cannot enable decolab-firewall.service: the trial ends by itself"
    systemctl stop "$timer.timer" >/dev/null 2>&1
    if timer_active; then die "the timer $timer did not stop: it will switch the firewall off"; fi
    rm -f "$pending" "$pending_rules"
    date +%s >"$confirmed"
    # Enabled is for the next boot; started is for now, or monitor.sh sees an
    # inactive unit until then. Its start loads the same rules once more.
    systemctl start decolab-firewall.service >/dev/null 2>&1 ||
      log "WARNING: decolab-firewall.service did not start; the rules are loaded, the unit starts them at the next boot"
    log "CONFIRMED from $S_PEER: the firewall stays and starts at every boot."
    ;;
  off)
    need_root off
    "$boot" off "decolab-firewall off" ;;
  status)
    if [ -f "$pending" ]; then echo "on trial since $(cat "$pending") (timer: $(systemctl is-active "$timer.timer" 2>/dev/null))"
    elif [ -f "$confirmed" ]; then echo "confirmed; decolab-firewall.service: $(systemctl is-active decolab-firewall.service 2>/dev/null)"
    else echo "off"; fi ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2 && exit 2 ;;
esac
