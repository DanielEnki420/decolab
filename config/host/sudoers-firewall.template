# Firewall check (HARDENING=yes), installed as /etc/sudoers.d/decolab-firewall (440 root:root).
#
# install.sh renders this file with exactly these variables: ${DECOLAB_USER}
#
# scripts/monitor.sh reads Decolab's own nftables table every 15 minutes:
# exactly this command, nothing that changes a rule.
${DECOLAB_USER} ALL=(root) NOPASSWD: /usr/sbin/nft list table inet decolab
