# NUT (HW_UPS), installed as /etc/nut/upsmon.conf (640 root:nut).
#
# install.sh renders this file with exactly these variables: ${UPSMON_PASSWORD}
MONITOR ups@127.0.0.1 1 upsmon ${UPSMON_PASSWORD} primary
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POWERDOWNFLAG /etc/killpower
# Time for the "shutting down" notification before SHUTDOWNCMD runs.
FINALDELAY 10
POLLFREQ 5
POLLFREQALERT 5
DEADTIME 15
RUN_AS_USER nut

# On a primary, LOWBATT triggers the shutdown at once; it is reported as
# FSD/SHUTDOWN (ups-event.sh reports only the first of them). Notifications
# go through upssched (timers against flicker) to ups-event.sh.
NOTIFYCMD /usr/sbin/upssched
NOTIFYFLAG ONBATT   SYSLOG+WALL+EXEC
NOTIFYFLAG ONLINE   SYSLOG+WALL+EXEC
NOTIFYFLAG LOWBATT  SYSLOG+WALL
NOTIFYFLAG FSD      SYSLOG+WALL+EXEC
NOTIFYFLAG COMMBAD  SYSLOG+WALL+EXEC
NOTIFYFLAG COMMOK   SYSLOG+WALL+EXEC
# NOCOMM repeats every NOCOMMWARNTIME (300 s). The 60 s timer on COMMBAD
# reports it once; ups-metrics.sh reports it to Uptime Kuma as well.
NOTIFYFLAG NOCOMM   SYSLOG+WALL
NOTIFYFLAG REPLBATT SYSLOG+WALL+EXEC
NOTIFYFLAG SHUTDOWN SYSLOG+WALL+EXEC
