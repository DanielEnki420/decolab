{
 "kind": "Dashboard",
 "metadata": {
  "name": "internet",
  "project": "decolab"
 },
 "spec": {
  "display": {
   "name": "Decolab — Internet"
  },
  "duration": "7d",
  "variables": [],
  "panels": {
   "statDownload": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Download (Mbit/s)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_download_mbit"
         }
        }
       }
      }
     ]
    }
   },
   "statUpload": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Upload (Mbit/s)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 1
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_upload_mbit"
         }
        }
       }
      }
     ]
    }
   },
   "statPing": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Ping (ms)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_ping_ms"
         }
        }
       }
      }
     ]
    }
   },
   "statAge": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Last measurement (hours ago)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 1
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "(time() - decolab_speedtest_last_success_timestamp_seconds) / 3600"
         }
        }
       }
      }
     ]
    }
   },
   "trendDownload": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Download (Mbit/s) – alert below half of the week's best"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_download_mbit",
          "seriesNameFormat": "Download"
         }
        }
       }
      },
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "0.5 * max_over_time(decolab_speedtest_download_mbit[7d])",
          "seriesNameFormat": "Alert threshold"
         }
        }
       }
      }
     ]
    }
   },
   "trendUpload": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Upload (Mbit/s)"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_upload_mbit",
          "seriesNameFormat": "Upload"
         }
        }
       }
      },
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "0.5 * max_over_time(decolab_speedtest_upload_mbit[7d])",
          "seriesNameFormat": "Alert threshold"
         }
        }
       }
      }
     ]
    }
   },
   "trendPing": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Ping and jitter (ms)"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_ping_ms",
          "seriesNameFormat": "Ping"
         }
        }
       }
      },
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_speedtest_jitter_ms",
          "seriesNameFormat": "Jitter"
         }
        }
       }
      }
     ]
    }
   }
  },
  "layouts": [
   {
    "kind": "Grid",
    "spec": {
     "display": {
      "title": "Last measurement"
     },
     "items": [
      {
       "x": 0,
       "y": 0,
       "width": 6,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/statDownload"
       }
      },
      {
       "x": 6,
       "y": 0,
       "width": 6,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/statUpload"
       }
      },
      {
       "x": 12,
       "y": 0,
       "width": 6,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/statPing"
       }
      },
      {
       "x": 18,
       "y": 0,
       "width": 6,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/statAge"
       }
      }
     ]
    }
   },
   {
    "kind": "Grid",
    "spec": {
     "display": {
      "title": "History"
     },
     "items": [
      {
       "x": 0,
       "y": 0,
       "width": 24,
       "height": 8,
       "content": {
        "$ref": "#/spec/panels/trendDownload"
       }
      },
      {
       "x": 0,
       "y": 8,
       "width": 12,
       "height": 7,
       "content": {
        "$ref": "#/spec/panels/trendUpload"
       }
      },
      {
       "x": 12,
       "y": 8,
       "width": 12,
       "height": 7,
       "content": {
        "$ref": "#/spec/panels/trendPing"
       }
      }
     ]
    }
   }
  ]
 }
}
