{
 "kind": "Dashboard",
 "metadata": {
  "name": "ups",
  "project": "decolab"
 },
 "spec": {
  "display": {
   "name": "Decolab — Power & UPS"
  },
  "duration": "24h",
  "variables": [],
  "panels": {
   "nowOnLine": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "On mains power (1 = yes)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       },
       "thresholds": {
        "defaultColor": "#e02f44",
        "steps": [
         {
          "value": 1,
          "color": "#56a64b"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_on_line"
         }
        }
       }
      }
     ]
    }
   },
   "nowBattery": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Battery (%)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       },
       "thresholds": {
        "defaultColor": "#e02f44",
        "steps": [
         {
          "value": 30,
          "color": "#e0b400"
         },
         {
          "value": 60,
          "color": "#56a64b"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_battery_percent"
         }
        }
       }
      }
     ]
    }
   },
   "nowRuntime": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Runtime left (min, UPS estimate)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       },
       "thresholds": {
        "defaultColor": "#e02f44",
        "steps": [
         {
          "value": 10,
          "color": "#e0b400"
         },
         {
          "value": 20,
          "color": "#56a64b"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_runtime_seconds / 60"
         }
        }
       }
      }
     ]
    }
   },
   "nowLoad": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Load (%)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_load_percent"
         }
        }
       }
      }
     ]
    }
   },
   "nowReachable": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "NUT answers (1 = yes)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       },
       "thresholds": {
        "defaultColor": "#e02f44",
        "steps": [
         {
          "value": 1,
          "color": "#56a64b"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_reachable"
         }
        }
       }
      }
     ]
    }
   },
   "nowReplace": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Replace battery? (0 = no)"
     },
     "plugin": {
      "kind": "StatChart",
      "spec": {
       "calculation": "last",
       "format": {
        "unit": "decimal",
        "decimalPlaces": 0
       },
       "thresholds": {
        "defaultColor": "#56a64b",
        "steps": [
         {
          "value": 1,
          "color": "#e02f44"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_replace_battery"
         }
        }
       }
      }
     ]
    }
   },
   "trendBattery": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Battery charge (%) and shutdown threshold"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       },
       "thresholds": {
        "defaultColor": "#e02f44",
        "steps": [
         {
          "value": 30,
          "color": "#56a64b"
         }
        ]
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_battery_percent",
          "seriesNameFormat": "Battery"
         }
        }
       }
      },
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_shutdown_battery_percent",
          "seriesNameFormat": "Shutdown below"
         }
        }
       }
      }
     ]
    }
   },
   "trendRuntime": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Runtime left (min)"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_runtime_seconds / 60",
          "seriesNameFormat": "Runtime left"
         }
        }
       }
      }
     ]
    }
   },
   "trendOnBattery": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Power outages (1 = on battery)"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_on_battery",
          "seriesNameFormat": "on battery"
         }
        }
       }
      }
     ]
    }
   },
   "trendVolts": {
    "kind": "Panel",
    "spec": {
     "display": {
      "name": "Voltage at the UPS outlets (V)"
     },
     "plugin": {
      "kind": "TimeSeriesChart",
      "spec": {
       "legend": {
        "position": "bottom"
       },
       "yAxis": {
        "format": {
         "unit": "decimal"
        }
       }
      }
     },
     "queries": [
      {
       "kind": "TimeSeriesQuery",
       "spec": {
        "plugin": {
         "kind": "PrometheusTimeSeriesQuery",
         "spec": {
          "query": "decolab_ups_output_volts",
          "seriesNameFormat": "Output"
         }
        }
       }
      }
     ]
    }
   }
  },
  "layouts": [
   {
    "kind": "Grid",
    "spec": {
     "display": {
      "title": "Now"
     },
     "items": [
      {
       "x": 0,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowOnLine"
       }
      },
      {
       "x": 4,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowBattery"
       }
      },
      {
       "x": 8,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowRuntime"
       }
      },
      {
       "x": 12,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowLoad"
       }
      },
      {
       "x": 16,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowReachable"
       }
      },
      {
       "x": 20,
       "y": 0,
       "width": 4,
       "height": 3,
       "content": {
        "$ref": "#/spec/panels/nowReplace"
       }
      }
     ]
    }
   },
   {
    "kind": "Grid",
    "spec": {
     "display": {
      "title": "History"
     },
     "items": [
      {
       "x": 0,
       "y": 0,
       "width": 12,
       "height": 7,
       "content": {
        "$ref": "#/spec/panels/trendBattery"
       }
      },
      {
       "x": 12,
       "y": 0,
       "width": 12,
       "height": 7,
       "content": {
        "$ref": "#/spec/panels/trendRuntime"
       }
      },
      {
       "x": 0,
       "y": 7,
       "width": 12,
       "height": 6,
       "content": {
        "$ref": "#/spec/panels/trendOnBattery"
       }
      },
      {
       "x": 12,
       "y": 7,
       "width": 12,
       "height": 6,
       "content": {
        "$ref": "#/spec/panels/trendVolts"
       }
      }
     ]
    }
   }
  ]
 }
}
