# Samba (crazymax/samba): one share on the data disk for the Decolab user.
#
# install.sh renders this file with exactly these variables: ${DECOLAB_USER} ${DECOLAB_UID} ${DECOLAB_GID}
# The result goes to SECRETS_DIR/samba.yml. The password is never written
# here: the container reads it from SECRETS_DIR/samba_password (generated by
# install.sh).

auth:
  - user: ${DECOLAB_USER}
    group: ${DECOLAB_USER}
    uid: ${DECOLAB_UID}
    gid: ${DECOLAB_GID}
    password_file: /run/secrets/samba_password

global:
  - "server string = Decolab NAS"
  - "server role = standalone server"
  - "log level = 1"
  - "max log size = 10"

share:
  - name: NAS
    path: /mount
    browsable: yes
    readonly: no
    guestok: no
    validusers: ${DECOLAB_USER}
    writelist: ${DECOLAB_USER}
    # macOS metadata files stay on the Mac
    veto files: /._*/.DS_Store/
    delete veto files: yes
